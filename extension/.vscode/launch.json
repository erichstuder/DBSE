{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Run Extension",
			"type": "extensionHost",
			"request": "launch",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}/sysmlv2-renderer",
				"${workspaceFolder}/../examples/stm32f446re/src/",
				"${workspaceFolder}/../examples/stm32f446re/src/LedControl.sysml",
			],
			"outFiles": [
				"${workspaceFolder}/sysmlv2-renderer/out/**/*.js"
			],
			"preLaunchTask": "${defaultBuildTask}"
		}
	]
}
