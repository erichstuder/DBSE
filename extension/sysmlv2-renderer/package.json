{
  "name": "sysmlv2-renderer",
  "displayName": "SysMLv2 Renderer",
  "description": "SysML v2 graphical rendering",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sysmlv2-renderer.openPreview",
        "title": "SysMLv2: Open Preview"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "sysmlv2-renderer.openPreview",
          "when": "resourceExtname == .sysml"
        }
      ],
      "editor/title": [
        {
          "command": "sysmlv2-renderer.openPreview",
          "when": "resourceExtname == .sysml",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.107.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.0.3",
    "typescript-eslint": "^8.48.1",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "sinon": "^21.0.1",
    "@types/sinon": "^21.0.0"
  }
}
